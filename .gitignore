# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / PWA
node_modules/
dist/
build/
.vite/
*.local

# Secrets / config
.env
.env.*
!.env.example
config.yaml
config.local.yaml
secrets/
*.key
*.pem

# Data / DB（R9 脱敏对齐：data/*.db / data/company_tickers.json 镜像 R9 清单——
# .gitignore 是 R9 的机械执行手段，清单加本地文件就同步加一条；不用 data/ 整个目录）
data/*.db
data/company_tickers.json
*.db
*.sqlite
*.sqlite3
*.db-journal

# Notion snapshots are tracked (assets/), but never write to Notion live
# (enforced by policy, not gitignore)

# OS
.DS_Store
Thumbs.db

# Build / packaging
*.spec
*.zip

# WorkBuddy local artifacts (automations, etc.) — never commit
.workbuddy/

# Local run artifacts / caches — never commit
_thesis_pull_log.txt
scripts/_*.json
evals/_*              # 生成产物（_extractions/_l1_result/_blind_*/_blind_source_map/_w2_result）可复现；用户源（ground_truth/blind_verdicts/blind_pairs）tracked
evals/w2_converged_cards.yaml  # W2 生成（含真实 thesis，可复现）

# Playwright 截图（测试产物，含真实 thesis，可复现，不提交）
screenshots/
shots/
frontend/screenshots/
